// Style card F (ambient): 64 BPM easing to 56, D lydian, a chord every two bars, no drums, pad, bells and noise.
// Dmaj7 E/D Bm7 C#m7, a wavetable pad, slow bell arpeggios at a 1.5-beat rate against the bar, a pink-noise bed and long
// reverb and echo tails.
// Its values are this card's choices, not defaults: take tempo, key, meter, chords and sounds from your own card
// (skills/compose-song/reference/styles.md).
{
  "title": "Low Tide Glass",
  "bpm": 64,
  "meter": 4,
  "key": "D lydian",

  "instruments": {
    "pad":   {"synthPreset": "Wavetable pad"},
    "bells": {"synthPreset": "Bell keys"},
    "voice": {"synthPreset": "Wavetable vox"},
    "low":   "synth:sub-bass"
  },

  "tracks": {
    "pad":   {"instrument": "pad", "layer": "Harmony", "gain": 0.22, "attack": 2.5, "release": 4,
              "effects": {"LowPassHz": 5000},
              "modulators": [{"kind": "lfo", "target": "lowpass", "amount": 0.7, "wave": "Sine", "syncBeats": 16}],
              "sends": [{"bus": "hall", "db": -4}]},
    "bells": {"instrument": "bells", "layer": "Harmony", "gain": 0.14, "pan": -0.35, "release": 3,
              "effects": {"EchoWet": 0.35, "EchoBeats": 1.5, "EchoFeedback": 0.5}, "sends": [{"bus": "hall", "db": -2}]},
    "voice": {"instrument": "voice", "gain": 0.12, "pan": 0.3, "attack": 1.2, "release": 3, "sends": [{"bus": "hall", "db": 0}]},
    "low":   {"instrument": "low", "layer": "Bass", "gain": 0.28, "attack": 1.5, "release": 3}
  },

  "buses": {"hall": {"effects": {"Reverb": true, "ReverbMix": 1, "ReverbSize": 0.92, "ReverbDamping": 0.35}}},

  "patterns": {
    // a few long chord tones (the lydian #4, G#, over E/D), never on the downbeat
    "drift": {"bars": 8, "melody": "r:2 A5:6 | G#5:4 E5:4 | r:2 F#5:6 | r:2 C#6:2 B5:4"}
  },

  "tempo": [{"section": "fade", "bpm": 56, "rampBeats": 16}],

  "sections": [
    {"name": "open", "bars": 4, "play": {
      "pad": {"chords": "Dmaj7:2 E/D:2", "voices": 4, "range": ["D3", "A4"]}}},
    {"name": "bloom", "bars": 16, "play": {
      "pad":   {"chords": "Dmaj7:2 E/D:2 Bm7:2 C#m7:2", "voices": 5, "range": ["D3", "C#5"]},
      "bells": {"chords": "Dmaj7:2 E/D:2 Bm7:2 C#m7:2", "as": "arp", "order": "random", "rate": 1.5, "octaves": 2,
                "gate": 0.5, "range": ["A4", "E6"], "velocity": 0.7},
      "low":   {"chords": "Dmaj7:2 E/D:2 Bm7:2 C#m7:2", "as": "bass", "style": "root", "register": "D2"},
      "voice": "drift"}},
    {"name": "fade", "bars": 8, "play": {
      "pad":   {"chords": "E/D:2 Dmaj7:2", "voices": 4, "range": ["D3", "A4"]},
      "bells": {"chords": "E/D:2 Dmaj7:2", "as": "arp", "order": "down", "rate": 3, "octaves": 1, "gate": 0.4,
                "range": ["A4", "E6"], "velocity": 0.5}}}
  ],

  "regions": [{"kind": "Pink", "bar": 1, "beats": 112, "Gain": 0.02, "FadeInBeats": 16, "FadeOutBeats": 24}],
  "masterAutomation": {"volume": [{"bar": 1, "value": -36}, {"bar": 5, "value": 0, "curve": "smooth"},
                                  {"section": "fade", "bar": 5, "value": 0}, {"section": "fade", "bar": 9, "value": -40, "curve": "smooth"}]},
  "output": {"tail": 6},
  "targetLufs": -18
}
